# Gmail MCP Server — Environment Configuration
# Copy this file to .env and fill in the values appropriate for your environment.
# Never commit a populated .env to source control.

# ── Credential & config paths ────────────────────────────────────────────────
# Directory where credentials.json and gcp-oauth.keys.json are stored.
# Defaults to ~/.gmail-mcp when not set.
GMAIL_CONFIG_DIR=

# Absolute path to gcp-oauth.keys.json (overrides GMAIL_CONFIG_DIR for this file).
GMAIL_OAUTH_PATH=

# Absolute path to credentials.json (overrides GMAIL_CONFIG_DIR for this file).
GMAIL_CREDENTIALS_PATH=

# ── File-read security ───────────────────────────────────────────────────────
# Root directory that constrains all server-side file reads (attachments,
# htmlBodyFile, inline_images). Every path supplied by a caller must resolve
# within this directory. Defaults to process.cwd() when not set.
GMAIL_MCP_ALLOWED_READ_PATH=

# ── OAuth scope level ────────────────────────────────────────────────────────
# Controls which Gmail OAuth scopes are requested.
# Values: MINIMAL | STANDARD | FULL  (default: FULL)
#   MINIMAL  — read-only access
#   STANDARD — read and send
#   FULL     — full modify + send (required for filters/labels)
GMAIL_MCP_SCOPE_LEVEL=FULL

# ── Rate limiting ────────────────────────────────────────────────────────────
# Maximum API calls per minute (default: 250).
GMAIL_MCP_RATE_LIMIT=250

# Daily Gmail API quota limit (default: 1000000000).
GMAIL_MCP_DAILY_QUOTA=1000000000

# ── Audit logging ────────────────────────────────────────────────────────────
# Minimum log level. Values: DEBUG | INFO | WARN | ERROR  (default: INFO)
GMAIL_MCP_LOG_LEVEL=INFO

# Write audit log entries to the console (default: true). Set to 'false' to silence.
GMAIL_MCP_AUDIT_CONSOLE=true

# Absolute path to a file where audit log entries are written (optional).
# Leave blank to disable file logging.
GMAIL_MCP_AUDIT_LOG_PATH=

# How personally identifiable information is handled in audit logs.
# Values: redact | hash | domain_only | omit  (default: redact)
GMAIL_MCP_PII_MODE=redact

# ── Integration tests (opt-in) ───────────────────────────────────────────────
# Set to '1' to enable the live Gmail API integration test suite.
GMAIL_INTEGRATION=

# Gmail address to use as the draft recipient in integration tests.
GMAIL_INTEGRATION_ACCOUNT=
